# The partner commits CI builds molrs against -- the ONE place they are
# pinned. .github/workflows/ci-snapshot.yml reads this file for its mrec step,
# and so does `scripts/check.sh mrec` (through scripts/partners.py), so a
# local push is judged by the same molrec suite as CI, never by whatever a
# sibling ../molrec happens to have checked out.
#
# KEY=VALUE lines only (CI appends them to $GITHUB_ENV). SELF is this
# repository's directory in a partner layout.
#
# MOLREC_REF: the molrec commit whose conformance suite and molrs adapter
# (tests/molrs_adapter.py) judge molrs.io.mrec. A floating ref would run
# whatever lands there; bump it deliberately when molrec's adapter moves.
SELF=molrs
MOLREC_REPOSITORY=MolCrafts/molrec
MOLREC_REF=aa83a3387f114dc098a7ee06e800e3a8f1a29f16
