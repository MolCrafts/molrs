# The partner repositories molrs is checked against. scripts/partners.py
# resolves them, for `scripts/check.sh mrec` (test.yml's `test / mrec` and the
# pre-push hook) and nightly.yml's conformance snapshot (`partners.py fetch`)
# alike, so a local push is judged by the same molrec suite as CI,
# never by whatever a sibling ../molrec happens to have checked out.
#
# KEY=VALUE lines only. SELF is this repository's directory in a partner
# layout.
#
# MOLREC: the molrec conformance suite and molrs adapter
# (tests/molrs_adapter.py) that judge molrs.io.mrec. On dev, partners are
# tracked, not pinned: MOLREC_REF=dev is molrec's dev tip -- or molrec's
# branch of the same name as the one being built, when molrec has one (a
# change spanning both repositories; see "Partners" in
# molrs-python/docs/contributing.md). A release names a tag or commit here
# instead (docs/releasing.md).
SELF=molrs
MOLREC_REPOSITORY=MolCrafts/molrec
MOLREC_REF=dev
