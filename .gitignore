# Generated by Cargo
# will have compiled files and executables
debug
target
target-aarch64/
# Host-arch wasm-pack output (x86_64 login node). Publish uses npm @molcrafts/molrs.
molrs-wasm/.x86_64/
# Isolated Cargo target dirs for verification runs (capi CMake honours
# CARGO_TARGET_DIR; the repo's own target/ lives on Lustre, where cargo can
# deadlock on flock).
target-test/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Python
__pycache__/
.venv/
*.py[cod]
*$py.class
*.so
*.dSYM
*.dSYM/

# macOS
.DS_Store

# Codex local state
.agents/
AGENTS.md

# Claude Code scheduler lock
.claude/scheduled_tasks.lock

# Example output files
*.xyz
!molrs-python/tests/data/*.xyz
!molrs-python/tests/data/*.pdb

# Generated bindings and packaging artifacts
site/
docs/site/
molrs-capi/include/molrs.h
pkg/
molrs-wasm/pkg/
molrs-wasm/dist/
molrs-python/python/molrs/*.dylib
molrs-python/python/molrs/*.dll
molrs-python/python/molrs/*.so
molrs-python/python/molrs/*.dylib.dSYM/
molrs-cxxapi/src/bridge.rs

.claude/worktrees/

# Lock files. molrs ships as a library (crates.io / PyPI / npm), so a lock
# pins nothing downstream; CI resolves fresh and catches upstream breakage.
Cargo.lock
uv.lock
# The Python dev environment is pinned like the five Cargo.lock files.
!molrs-python/uv.lock

.tox/

target-aarch64/
**/target-aarch64/
molrs-python/python/molrs/_lib.abi3.so.*

# Per-architecture toolchain and wheel output for the GH200 build job
.cargo-aarch64/
.rustup-aarch64/
.wheels-aarch64/
scripts/molrs-aarch64-*.out
scripts/molrs-aarch64-*.err

# Tool caches (never tracked)
.pytest_cache/
.ruff_cache/
.ci-out/
